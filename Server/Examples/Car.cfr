/*
Example from <a href="https://wiselab.uwaterloo.ca/modelwiki/NECSIS-Workshop/Modeling%20Variability%207" target="exampleSource">wiki</a>
*/

BumbleBee : Camaro
    [ transformer ]

abstract Camaro : Car
    [ ACC ]
    [ backlight ]
    transformer ?

abstract Car
    ABS ?
    xor Transmission
        Automatic
        Manual
    `FCA ?
    `CC ?
    [ ACC => FCA ]

abstract FCA
    xor Sensor
        Radar
        Lidar
    xor Alert
        Haptic
        Audible

abstract CC
    switch
        backlight ?
    ACC ?

